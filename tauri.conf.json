{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIDAWARP",
  "version": "0.1.0",
  "identifier": "dev.aidawarp.desktop",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AIDAWARP LAUNCHER",
        "width": 760,
        "height": 560,
        "minWidth": 600,
        "minHeight": 460,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "AIDAWARP Scratch converter"
  }
}
